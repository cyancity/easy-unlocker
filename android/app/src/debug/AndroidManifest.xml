<?xml version="1.0" encoding="utf-8"?>
<!-- debug 构建专用：放行回环与验收用 LAN 地址的明文 HTTP（本机测试 Broker）。
     release 构建不带这个配置，非本机 http 仍被系统层拦住。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- realme UI 实测不认 domain-config 放行（localhost/127.0.0.1/IPv4 全被拦），
         debug 构建直接放开 cleartext；release 仍走 manifest 的 usesCleartextTraffic=false。 -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
